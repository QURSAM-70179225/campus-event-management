# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# REQUIRED. Use a long random string. Generate one in PowerShell with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Database --------------------------------------------------------------
# Default: a local SQLite file (relative to /backend or an absolute path).
DB_PATH=database/campus_events.db

# Optional: use a Turso (hosted SQLite) database instead of the local file.
# Used for the free deployment. When TURSO_DATABASE_URL is set, DB_PATH is ignored
# and every command (npm run dev, db:reset, db:seed, create-admin) works on Turso.
# Leave these empty for normal local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# -----------------------------------------------------------------------------

# Frontend URL(s) allowed by CORS — comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Timezone used to decide whether an event is upcoming or past
APP_TIMEZONE=Asia/Karachi

# Insert sample University of Lahore events when the events table is empty
SEED_SAMPLE_DATA=true
