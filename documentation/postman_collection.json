{
  "info": {
    "name": "Campus Event Management API",
    "description": "REST API for the UOL Campus Event Management System. Run 'Login (admin)' first. Create the admin with `npm run create-admin` and put its credentials in the adminEmail/adminPassword collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@uol.edu.pk"
    },
    {
      "key": "adminPassword",
      "value": "change-me"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "eventId",
      "value": "1"
    },
    {
      "key": "registrationId",
      "value": ""
    }
  ],
